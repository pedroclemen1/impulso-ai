{
  "name": "impulso-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Impulso AI — plataforma de capacitação em IA para profissionais de recrutamento e seleção",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @impulso/api --filter @impulso/web dev",
    "dev:api": "pnpm --filter @impulso/api dev",
    "dev:web": "pnpm --filter @impulso/web dev",
    "build": "pnpm --filter @impulso/shared build && pnpm --filter @impulso/api build && pnpm --filter @impulso/web build",
    "start": "pnpm --filter @impulso/api start",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "pnpm --filter @impulso/api prisma:generate",
    "db:migrate": "pnpm --filter @impulso/api prisma:migrate",
    "db:deploy": "pnpm --filter @impulso/api prisma:deploy",
    "db:seed": "pnpm --filter @impulso/api seed",
    "db:reset": "pnpm --filter @impulso/api db:reset",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @impulso/api test",
    "test:unit": "pnpm --filter @impulso/api test:unit",
    "test:integration": "pnpm --filter @impulso/api test:integration",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.0",
    "@prisma/client": "6.19.3",
    "embedded-postgres": "17.6.0-beta.15",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "embedded-postgres",
      "@embedded-postgres/linux-x64"
    ]
  }
}
