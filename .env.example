# ─── Banco de dados ───
DATABASE_URL=postgresql://impulso:impulso@localhost:5432/impulso
# Usado pelos testes de integração (é recriado a cada execução)
TEST_DATABASE_URL=postgresql://impulso:impulso@localhost:5432/impulso_test

# ─── Servidor ───
NODE_ENV=development
PORT=3333
# Origens permitidas (CORS/CSRF), separadas por vírgula
WEB_ORIGIN=http://localhost:5173
# Duração da sessão (horas) e expiração por inatividade (minutos)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Em produção, defina COOKIE_SECURE=true (exige HTTPS)
COOKIE_SECURE=false

# ─── Seed ───
# Credenciais demonstrativas só são criadas quando SEED_DEMO_DATA=true.
# O seed recusa-se a criar usuários demonstrativos com NODE_ENV=production
# a menos que ALLOW_DEMO_IN_PRODUCTION=true.
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@impulso.ai
SEED_ADMIN_PASSWORD=Impulso@2026

# ─── Inteligência artificial ───
# Provedor padrão: demo | openai | anthropic | gemini | openai_compatible | ollama
# "demo" é determinístico e não exige chave — ideal para testar a plataforma.
AI_PROVIDER=demo
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
# Opcional: preço por milhão de tokens (USD) do modelo ativo, para estimar custos no painel
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Qualquer endpoint compatível com a API da OpenAI (Groq, Together, vLLM, LM Studio...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Modelos locais via Ollama (endpoint compatível com OpenAI)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
