// Impulso AI — modelo de dados relacional
// Convenções: UUIDs, timestamps em UTC, conteúdo de cursos versionado (CourseVersion)
// para preservar a integridade histórica de tentativas e avaliações.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssessmentKind {
  DIAGNOSTIC
  MODULE_QUIZ
  FINAL
  SATISFACTION
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  LIKERT
  TRUE_FALSE
  OPEN
  SCENARIO
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ActivityType {
  OPEN_RESPONSE
  PROMPT_EXERCISE
  CASE_STUDY
  CRITICAL_ANALYSIS
  WORKFLOW_DESIGN
}

enum SubmissionStatus {
  SUBMITTED
  EVALUATED
  EVALUATION_FAILED
}

enum EvaluationSource {
  AI
  DEMO
  FALLBACK
  HUMAN
}

enum LessonStage {
  LEARN
  CONTEXTUALIZE
  PRACTICE
  REFLECT
  IMPROVE
  CONSOLIDATE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TutorRole {
  STUDENT
  TUTOR
  SYSTEM
}

enum TutorMessageKind {
  MESSAGE
  SUBMISSION
  SOCRATIC_FEEDBACK
  HINT
  SOLUTION
  CONSOLIDATION
  NOTICE
}

enum AIUsageStatus {
  SUCCESS
  ERROR
  FALLBACK
}

enum GenerationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────── Identidade ───────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isDemo       Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile             StudentProfile?
  sessions            Session[]
  cohortMemberships   CohortMember[]
  enrollments         Enrollment[]          @relation("EnrollmentStudent")
  assignedEnrollments Enrollment[]          @relation("EnrollmentAssigner")
  attempts            AssessmentAttempt[]
  submissions         ActivitySubmission[]
  reviewedEvaluations ActivityEvaluation[]  @relation("EvaluationReviewer")
  conversations       TutorConversation[]
  competencyScores    CompetencyScore[]
  learningSessions    LearningSession[]
  achievements        UserAchievement[]
  certificates        Certificate[]
  aiUsageLogs         AIUsageLog[]
  auditLogs           AuditLog[]
  createdCourses      Course[]
  generationJobs      CourseGenerationJob[]

  @@index([role, status])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StudentProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  jobTitle            String?
  department          String?
  company             String?
  knowledgeLevel      Int?
  professionalContext String?
  learningGoals       String?
  challenges          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cohort {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     CohortMember[]
  enrollments Enrollment[]
}

model CohortMember {
  id        String   @id @default(uuid()) @db.Uuid
  cohortId  String   @db.Uuid
  userId    String   @db.Uuid
  joinedAt  DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId])
}

// ─────────────────────────────── Cursos ───────────────────────────────

model Course {
  id                       String       @id @default(uuid()) @db.Uuid
  slug                     String       @unique
  title                    String
  status                   CourseStatus @default(DRAFT)
  coverColor               String       @default("indigo")
  generatedByAI            Boolean      @default(false)
  isDemo                   Boolean      @default(false)
  createdById              String?      @db.Uuid
  latestPublishedVersionId String?      @unique @db.Uuid
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  createdBy              User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions               CourseVersion[]       @relation("CourseVersions")
  latestPublishedVersion CourseVersion?        @relation("LatestPublished", fields: [latestPublishedVersionId], references: [id])
  enrollments            Enrollment[]
  generationJobs         CourseGenerationJob[]
}

model CourseVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  courseId           String              @db.Uuid
  versionNumber      Int
  status             CourseVersionStatus @default(DRAFT)
  title              String
  description        String
  objectives         Json                @default("[]")
  targetAudience     String              @default("")
  prerequisites      String              @default("")
  difficulty         Difficulty          @default(BEGINNER)
  estimatedHours     Float               @default(1)
  coverImageUrl      String?
  completionCriteria Json                @default("{}")
  addieNotes         Json                @default("{}")
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  course              Course                    @relation("CourseVersions", fields: [courseId], references: [id], onDelete: Cascade)
  latestPublishedOf   Course?                   @relation("LatestPublished")
  modules             Module[]
  assessments         Assessment[]
  competencies        CourseVersionCompetency[]
  enrollments         Enrollment[]

  @@unique([courseId, versionNumber])
  @@index([status])
}

model Module {
  id              String   @id @default(uuid()) @db.Uuid
  courseVersionId String   @db.Uuid
  order           Int
  title           String
  description     String   @default("")
  objectives      Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  assessments   Assessment[]

  @@index([courseVersionId, order])
}

model Lesson {
  id                String   @id @default(uuid()) @db.Uuid
  moduleId          String   @db.Uuid
  order             Int
  title             String
  summary           String   @default("")
  estimatedMinutes  Int      @default(15)
  learnContent      String   @default("")
  beginnerSupport   String?
  advancedDeepDive  String?
  contextContent    String   @default("")
  videoUrl          String?
  resources         Json     @default("[]")
  reflectionPrompt  String   @default("")
  keyTakeaways      Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module       Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  competencies LessonCompetency[]
  activity     Activity?
  progress     LearningProgress[]
  tutorConvos  TutorConversation[]

  @@index([moduleId, order])
}

model Competency {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String   @default("")
  category    String   @default("Geral")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseVersions CourseVersionCompetency[]
  lessons        LessonCompetency[]
  questions      Question[]
  scores         CompetencyScore[]
  achievements   Achievement[]
}

model CourseVersionCompetency {
  courseVersionId String @db.Uuid
  competencyId    String @db.Uuid

  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  competency    Competency    @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([courseVersionId, competencyId])
}

model LessonCompetency {
  lessonId     String @db.Uuid
  competencyId String @db.Uuid
  weight       Float  @default(1)

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([lessonId, competencyId])
}

// ─────────────────────────────── Avaliações objetivas ───────────────────────────────

model Assessment {
  id              String         @id @default(uuid()) @db.Uuid
  courseVersionId String         @db.Uuid
  moduleId        String?        @db.Uuid
  kind            AssessmentKind
  title           String
  description     String         @default("")
  passingScore    Float          @default(70)
  maxAttempts     Int            @default(3)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  courseVersion CourseVersion       @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  module        Module?             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      AssessmentAttempt[]

  @@index([courseVersionId, kind])
  @@index([moduleId])
}

model Question {
  id           String       @id @default(uuid()) @db.Uuid
  assessmentId String       @db.Uuid
  order        Int
  type         QuestionType
  prompt       String
  helpText     String?
  dimension    String?
  competencyId String?      @db.Uuid
  points       Float        @default(1)
  isScored     Boolean      @default(true)
  selfReported Boolean      @default(false)
  explanation  String?
  likertLabels Json         @default("[]")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competency Competency?        @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  options    QuestionOption[]
  answers    AssessmentAnswer[]

  @@index([assessmentId, order])
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  order      Int
  label      String
  isCorrect  Boolean @default(false)
  score      Float?
  feedback   String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model AssessmentAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  assessmentId   String        @db.Uuid
  enrollmentId   String        @db.Uuid
  userId         String        @db.Uuid
  attemptNumber  Int
  status         AttemptStatus @default(IN_PROGRESS)
  objectiveScore Float?
  selfReportScore Float?
  overallScore   Float?
  passed         Boolean?
  level          Int?
  result         Json?
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]

  @@unique([assessmentId, enrollmentId, attemptNumber])
  @@index([userId])
  @@index([enrollmentId])
}

model AssessmentAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @db.Uuid
  questionId        String   @db.Uuid
  selectedOptionIds String[] @default([])
  likertValue       Int?
  booleanValue      Boolean?
  textAnswer        String?
  score             Float?
  isCorrect         Boolean?
  createdAt         DateTime @default(now())

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ─────────────────────────────── Atividades práticas e rubricas ───────────────────────────────

model Activity {
  id                String       @id @default(uuid()) @db.Uuid
  lessonId          String       @unique @db.Uuid
  type              ActivityType @default(OPEN_RESPONSE)
  title             String
  instructions      String
  scenario          String       @default("")
  guidedSteps       Json         @default("[]")
  advancedChallenge String?
  socraticQuestions Json         @default("[]")
  hints             Json         @default("[]")
  modelAnswer       String       @default("")
  expectedKeywords  Json         @default("[]")
  maxAttempts       Int          @default(4)
  passingScore      Float        @default(70)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  rubric      Rubric?
  submissions ActivitySubmission[]
}

model Rubric {
  id           String   @id @default(uuid()) @db.Uuid
  activityId   String   @unique @db.Uuid
  title        String
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activity Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]
}

model RubricCriterion {
  id          String @id @default(uuid()) @db.Uuid
  rubricId    String @db.Uuid
  key         String
  name        String
  description String @default("")
  weight      Float  @default(1)
  maxScore    Float  @default(100)
  indicators  Json   @default("[]")
  order       Int    @default(0)

  rubric Rubric                     @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores EvaluationCriterionScore[]

  @@unique([rubricId, key])
}

model ActivitySubmission {
  id                   String           @id @default(uuid()) @db.Uuid
  activityId           String           @db.Uuid
  enrollmentId         String           @db.Uuid
  userId               String           @db.Uuid
  attemptNumber        Int
  content              String
  isRevision           Boolean          @default(false)
  previousSubmissionId String?          @db.Uuid
  status               SubmissionStatus @default(SUBMITTED)
  createdAt            DateTime         @default(now())

  activity    Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  enrollment  Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations ActivityEvaluation[]

  @@unique([activityId, enrollmentId, attemptNumber])
  @@index([userId])
  @@index([enrollmentId])
}

model ActivityEvaluation {
  id                  String           @id @default(uuid()) @db.Uuid
  submissionId        String           @db.Uuid
  source              EvaluationSource
  provider            String?
  model               String?
  weightedScore       Float
  masteryLevel        String
  strengths           Json             @default("[]")
  improvements        Json             @default("[]")
  socraticQuestion    String           @default("")
  hint                String           @default("")
  recommendedAction   String           @default("")
  requiresHumanReview Boolean          @default(false)
  isCurrent           Boolean          @default(true)
  supersedesId        String?          @db.Uuid
  reviewedById        String?          @db.Uuid
  reviewNote          String?
  createdAt           DateTime         @default(now())

  submission  ActivitySubmission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy  User?                      @relation("EvaluationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  scores      EvaluationCriterionScore[]

  @@index([submissionId, isCurrent])
  @@index([requiresHumanReview])
}

model EvaluationCriterionScore {
  id            String @id @default(uuid()) @db.Uuid
  evaluationId  String @db.Uuid
  criterionId   String @db.Uuid
  score         Float
  justification String @default("")

  evaluation ActivityEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion    @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}

// ─────────────────────────────── Matrícula e progresso ───────────────────────────────

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  courseId        String           @db.Uuid
  courseVersionId String           @db.Uuid
  cohortId        String?          @db.Uuid
  assignedById    String?          @db.Uuid
  status          EnrollmentStatus @default(NOT_STARTED)
  progressPercent Float            @default(0)
  startDate       DateTime         @default(now())
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  lastActivityAt  DateTime?
  lastLessonId    String?          @db.Uuid
  initialLevel    Int?
  currentLevel    Int?
  initialScore    Float?
  duringScore     Float?
  finalScore      Float?
  passed          Boolean?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user             User                 @relation("EnrollmentStudent", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy       User?                @relation("EnrollmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVersion    CourseVersion        @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  cohort           Cohort?              @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  progress         LearningProgress[]
  attempts         AssessmentAttempt[]
  submissions      ActivitySubmission[]
  conversations    TutorConversation[]
  competencyScores CompetencyScore[]
  learningSessions LearningSession[]
  certificate      Certificate?
  achievements     UserAchievement[]

  @@unique([userId, courseVersionId])
  @@index([courseId, status])
  @@index([cohortId])
}

model LearningProgress {
  id                 String         @id @default(uuid()) @db.Uuid
  enrollmentId       String         @db.Uuid
  lessonId           String         @db.Uuid
  status             ProgressStatus @default(NOT_STARTED)
  currentStage       LessonStage    @default(LEARN)
  reflectionText     String?
  personalizedExample String?
  hintsUsed          Int            @default(0)
  solutionRevealed   Boolean        @default(false)
  consolidation      Json?
  startedAt          DateTime       @default(now())
  completedAt        DateTime?
  updatedAt          DateTime       @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model CompetencyScore {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  enrollmentId  String   @db.Uuid
  competencyId  String   @db.Uuid
  initialScore  Float?
  score         Float
  evidenceCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, competencyId])
  @@index([userId])
}

model LearningSession {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  enrollmentId    String?  @db.Uuid
  startedAt       DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  activeSeconds   Int      @default(0)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([userId, lastHeartbeatAt])
  @@index([startedAt])
}

// ─────────────────────────────── Tutor ───────────────────────────────

model TutorConversation {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  enrollmentId String   @db.Uuid
  lessonId     String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  messages   TutorMessage[]

  @@unique([enrollmentId, lessonId])
  @@index([userId])
}

model TutorMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           TutorRole
  kind           TutorMessageKind @default(MESSAGE)
  content        String
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────── Motivação ───────────────────────────────

model Achievement {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  title        String
  description  String
  icon         String   @default("award")
  competencyId String?  @db.Uuid
  criteria     Json     @default("{}")
  createdAt    DateTime @default(now())

  competency Competency?       @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  awards     UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  enrollmentId  String?  @db.Uuid
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  enrollment  Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, achievementId])
}

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  userId        String   @db.Uuid
  enrollmentId  String   @unique @db.Uuid
  studentName   String
  courseTitle   String
  versionNumber Int
  finalScore    Float
  hours         Float
  issuedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── IA, configuração e auditoria ───────────────────────────────

model AISettings {
  id                          String   @id @default("default")
  activeProvider              String   @default("demo")
  model                       String?
  temperature                 Float    @default(0.4)
  maxOutputTokens             Int      @default(2000)
  tutorAttemptsBeforeSolution Int      @default(3)
  tutorMaxHints               Int      @default(3)
  tutorMaxMessagesPerLesson   Int      @default(40)
  tutorTone                   String   @default("cordial e objetivo")
  tutorExtraInstructions      String   @default("")
  humanReviewBelowScore       Float    @default(40)
  monthlyBudgetUsd            Float?
  updatedAt                   DateTime @updatedAt
}

model AIUsageLog {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String?       @db.Uuid
  provider         String
  model            String
  operation        String
  inputTokens      Int?
  outputTokens     Int?
  latencyMs        Int
  status           AIUsageStatus
  errorCode        String?
  estimatedCostUsd Float?
  createdAt        DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([operation])
}

model CourseGenerationJob {
  id             String              @id @default(uuid()) @db.Uuid
  idempotencyKey String              @unique
  createdById    String              @db.Uuid
  params         Json
  status         GenerationJobStatus @default(PENDING)
  step           String              @default("outline")
  courseId       String?             @db.Uuid
  outline        Json?
  completedModules Int               @default(0)
  totalModules   Int                 @default(0)
  error          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
